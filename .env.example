# Copie para .env e ajuste se necessário.
# Bate com as credenciais e a porta (5433) do docker-compose.yml.
DATABASE_URL=postgresql+psycopg2://olist:olist@localhost:5433/olist

# Kaggle API: gere o token em https://www.kaggle.com/settings -> "Create New Token"
# e salve o kaggle.json em %USERPROFILE%\.kaggle\kaggle.json (Windows)
# ou ~/.kaggle/kaggle.json (Linux/macOS). Alternativamente, defina:
# KAGGLE_USERNAME=seu_usuario
# KAGGLE_KEY=sua_chave
